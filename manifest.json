{
  "manifest_version": 3,
  "name": "Extension Options",
  "description": "Search your extensions and open one's options page. Cmd+Shift+, opens the search box.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["management"],
  "action": {
    "default_title": "Search extension options",
    "default_popup": "pick.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "mac": "Command+Shift+Comma"
      }
    }
  }
}
